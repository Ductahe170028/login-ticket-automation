# Server automation chinh (nhan webhook tu Odoo)
PORT=3000

# Mock HR + LMS API (gia lap he thong that, dung de test/demo — Module 4)
MOCK_API_PORT=4001
MOCK_API_KEY=demo-secret-key

# URL tro toi mock API (khi co he thong that, doi thanh URL + token that)
HR_API_BASE_URL=http://localhost:4001
LMS_API_BASE_URL=http://localhost:4001
HR_API_KEY=demo-secret-key
LMS_API_KEY=demo-secret-key

# Duong dan API (dung chung giua clients va mock-services)
HR_EMPLOYEES_PATH=/hr/employees
LMS_ACCOUNTS_PATH=/lms/accounts
ODOO_TICKETS_API_PATH=/api/tickets

# Ten header xac thuc API (mac dinh x-api-key)
API_KEY_HEADER=x-api-key

# Odoo (dien khi tich hop that; de trong van chay duoc o che do mo phong)
ODOO_BASE_URL=
ODOO_API_KEY=

# Catch-up: quet ticket login chua xu ly khi server vua khoi dong lai
CATCHUP_DAYS=7

# Tag Odoo sau automation (support loc queue)
TAG_AUTO_RESOLVED=auto-resolved
TAG_MANUAL_REVIEW=manual-review

# Nhan dien ticket login — phan cach bang dau phay
LOGIN_KEYWORDS=đăng nhập,dang nhap,login,password,mật khẩu,mat khau
LOGIN_TAGS=login

# Logger
LOG_DIR=logs
LOG_FILE=app.log
